# Public hostname. Caddy obtains and renews TLS certificates automatically.
DOMAIN=civicforge.example.org
ALLOWED_ORIGINS=https://civicforge.example.org

# Keep true for a visibly labelled SIH demonstration deployment. Set false for a real-data environment.
DEMO_ENV=true
SEED_ON_STARTUP=true
REQUIRE_POSTGRES=true
REQUIRE_DATABASE_TLS=true
REQUIRE_MALWARE_SCANNER=true
TRUST_PROXY_HOPS=2

# Local directory containing secret files generated by `npm run prod:prepare`.
SECRETS_DIR=./.secrets

# Encrypted off-host Restic repository. S3-compatible providers are supported.
RESTIC_REPOSITORY=s3:https://s3.example.com/civicforge-production
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12

# Optional OpenAI-compatible live provider. Demo AI remains available without these.
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
# Put the optional key in `.secrets/ai_api_key` or pass it once to `npm run prod:prepare`.
