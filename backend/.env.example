PORT=4000
JWT_SECRET=change-me-in-production-sih-demo
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production containers may use Docker secret files instead of inline values.
# DATABASE_URL_FILE=/run/secrets/database_url
# JWT_SECRET_FILE=/run/secrets/jwt_secret
# FILE_SIGNING_SECRET_FILE=/run/secrets/file_signing_secret
# METRICS_TOKEN_FILE=/run/secrets/metrics_token
# Supabase PostgreSQL URL from the Dashboard Connect panel (keep credentials private).
# DATABASE_URL=postgresql://postgres:...@db.<project-ref>.supabase.co:5432/postgres
# Download the project CA certificate from Database Settings -> SSL Configuration.
# DATABASE_CA_CERT_FILE=./.secrets/supabase-ca.crt
# PGlite is available only when explicitly selected for isolated local tests.
# DB_PROVIDER=pglite
# Optional isolated PGlite test database directory.
# PGLITE_DATA_DIR=./data/pglite
UPLOAD_DIR=./uploads
PRIVATE_UPLOAD_DIR=./private-uploads
FILE_SIGNING_SECRET=replace-with-a-separate-random-secret
METRICS_TOKEN=replace-with-a-third-independent-random-secret
LOG_SINK_URL=
LOG_SINK_TOKEN=
CLAMAV_HOST=
CLAMAV_PORT=3310
MALWARE_SCANNER_COMMAND=
REQUIRE_MALWARE_SCANNER=false
DEMO_ENV=true
SEED_ON_STARTUP=true
REQUIRE_POSTGRES=true
REQUIRE_DATABASE_TLS=true
TRUST_PROXY_HOPS=0
# Optional OpenAI-compatible live provider. If absent or unavailable, Demo AI Mode continues to work.
# AI_API_KEY=
# AI_API_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_EMBEDDING_MODEL=text-embedding-3-small
