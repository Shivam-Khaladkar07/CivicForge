# Reference for the NEW Render service. render.yaml sets these automatically.
# Do not replace backend/.env: it is for local development.
NODE_ENV=production
PORT=10000
DEMO_ENV=true
SEED_ON_STARTUP=true
REQUIRE_POSTGRES=true
REQUIRE_DATABASE_TLS=true
REQUIRE_MALWARE_SCANNER=true

# Set to the actual Vercel production origin from Project > Settings > Domains.
# Exact HTTPS origin, no /api or trailing slash. Do not use a guessed hostname.
ALLOWED_ORIGINS=
TRUST_PROXY_HOPS=1
DB_POOL_MAX=5

# Render secret file, supplied through the civicforge-render-secrets group.
# Its value must be a managed PostgreSQL connection string requiring TLS.
DATABASE_URL_FILE=/etc/secrets/database_url

# Blueprint generates these independently. Do not copy the local demo secret.
JWT_SECRET=
FILE_SIGNING_SECRET=
METRICS_TOKEN=
INTERNAL_METRICS_PORT=9090

# /data MUST be a persistent disk. ClamAV is a PRIVATE service.
PRIVATE_UPLOAD_DIR=/data/uploads
# Blueprint resolves the real internal scanner hostname automatically.
CLAMAV_HOST=
CLAMAV_PORT=3310

# Off-host encrypted backups, colocated with the API for disk access.
SECRETS_DIR=/etc/secrets
RESTIC_REPOSITORY=
RESTIC_CACHE_DIR=/data/restic-cache
BACKUP_STATE_DIR=/data/backup-state
RESTORE_WORK_DIR=/tmp/civicforge-restore
BACKUP_HOST_NAME=civicforge-render-demo
BACKUP_INTERVAL_SECONDS=86400

# Optional: leaving AI and log-sink configuration absent is supported.
# AI_API_KEY_FILE=/etc/secrets/ai_api_key
# LOG_SINK_URL_FILE=/etc/secrets/log_sink_url
# LOG_SINK_TOKEN_FILE=/etc/secrets/log_sink_token
