# CivicForge FREE DEMO configuration for Render.
# Do not replace backend/.env; that file is for local development.
# Do not put real secret values in this file or commit them.

NODE_ENV=production
PORT=10000
DEMO_ENV=true
SEED_ON_STARTUP=true
REQUIRE_POSTGRES=true
REQUIRE_DATABASE_TLS=true

# Free Render demo uses the built-in basic signature/EICAR check.
# This is NOT equivalent to a full ClamAV antivirus service.
REQUIRE_MALWARE_SCANNER=false
MALWARE_SCAN_MODE=basic

# Set to the exact public Vercel production origin, without a path or trailing slash.
ALLOWED_ORIGINS=

TRUST_PROXY_HOPS=1
DB_POOL_MAX=5

# Render Secret File:
# /etc/secrets/database_url
DATABASE_URL_FILE=/etc/secrets/database_url

# Render Secret File:
# /etc/secrets/supabase-ca.crt
DATABASE_CA_CERT_FILE=/etc/secrets/supabase-ca.crt
PGSSLROOTCERT=/etc/secrets/supabase-ca.crt
PGSSLMODE=verify-full

# Render Free filesystem is ephemeral.
# Files uploaded during a running demo session may disappear after restart,
# redeploy, or idle spin-down.
PRIVATE_UPLOAD_DIR=/tmp/civicforge-uploads
SECRETS_DIR=/etc/secrets

# No Render disk, private ClamAV service, Restic worker, or paid resource is required.
# AI and log sink settings remain optional; Demo AI works without an API key.
